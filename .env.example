# Contact form bot protection (Cloudflare Turnstile + throttling)
# TURNSTILE_ENABLED=True
# TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# TURNSTILE_EXPECTED_HOSTNAME=www.banbasresort.com

# Allow up to 5 POST attempts per IP every 5 minutes
# CONTACT_RATE_LIMIT_WINDOW_SECONDS=300
# CONTACT_RATE_LIMIT_MAX_ATTEMPTS=5
# Block submissions sent unrealistically fast
# CONTACT_MIN_SUBMIT_SECONDS=3
